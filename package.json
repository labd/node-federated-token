{
	"name": "federated-token",
	"version": "0.0.0",
	"author": "Lab Digital <opensource@labdigital.nl>",
	"description": "Federate JWT tokens between Apollo servers",
	"keywords": [
		"authentication",
		"graphql"
	],
	"private": "true",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "pnpm turbo build",
		"deps": "syncpack lint --dependency-types dev,prod,pnpmOverrides",
		"deps:fix": "syncpack fix --dependency-types dev,prod,pnpmOverrides && pnpm dedupe && pnpm install",
		"format": "biome format --fix",
		"lint": "biome check",
		"publish:ci": "pnpm build && pnpm changeset publish",
		"publish:version": "pnpm changeset version && pnpm format",
		"test": "turbo test",
		"test:ci": "turbo test:ci",
		"tsc": "turbo tsc"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@changesets/cli": "3.0.3",
		"@vitest/coverage-v8": "5.0.5",
		"syncpack": "15.3.3",
		"turbo": "2.11.9",
		"vitest": "5.0.5"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"module": "./dist/index.mjs",
	"packageManager": "pnpm@12.14.0",
	"repository": "labd/node-federated-token",
	"syncpack": {
		"indent": "\t",
		"sortFirst": [
			"name",
			"version",
			"author",
			"description",
			"keywords",
			"private",
			"license",
			"type",
			"main",
			"types",
			"exports",
			"imports",
			"sideEffects",
			"scripts"
		]
	},
	"workspaces": [
		"packages/*"
	]
}
