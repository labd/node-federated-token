{
	"name": "@labdigital/federated-token",
	"version": "4.0.1",
	"author": "Lab Digital <opensource@labdigital.nl>",
	"description": "Federate JWT tokens between Apollo servers",
	"keywords": [
		"authentication",
		"graphql"
	],
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./tokensource": {
			"types": "./dist/tokensource/index.d.ts",
			"import": "./dist/tokensource/index.js"
		}
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"test:ci": "vitest run --coverage",
		"tsc": "tsc --noEmit"
	},
	"dependencies": {
		"@types/node": "^26.6.5",
		"jose": "6.2.12",
		"node-mock-http": "1.0.5"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "5.0.5",
		"cookie": "2.0.1",
		"node-mocks-http": "1.18.1",
		"publint": "^0.3.25",
		"tsdown": "^0.23.1",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"files": [
		"dist",
		"src"
	],
	"module": "./dist/index.js",
	"peerDependencies": {
		"graphql": ">= 16.6.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/labd/node-federated-token.git",
		"directory": "packages/core"
	}
}
