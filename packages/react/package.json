{
	"name": "@labdigital/federated-token-react",
	"version": "4.0.2",
	"author": "Lab Digital <opensource@labdigital.nl>",
	"description": "Federate JWT tokens for React clients",
	"keywords": [
		"authentication",
		"graphql",
		"react"
	],
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"test:ci": "vitest run --coverage",
		"tsc": "tsc --noEmit"
	},
	"dependencies": {
		"jose": "6.2.12",
		"js-cookie": "3.0.8"
	},
	"devDependencies": {
		"@types/express": "5.0.6",
		"@types/js-cookie": "3.0.6",
		"@types/react": "19.3.0",
		"@vitest/coverage-v8": "5.0.5",
		"node-mocks-http": "1.18.1",
		"publint": "^0.3.25",
		"tsdown": "^0.23.1",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"files": [
		"dist",
		"src"
	],
	"module": "./dist/index.js",
	"peerDependencies": {
		"graphql": ">= 16.6.0",
		"react": ">= 18.0.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/labd/node-federated-token.git",
		"directory": "packages/react"
	}
}
