{
	"name": "@labdigital/federated-token-yoga",
	"version": "3.0.0",
	"author": "Lab Digital <opensource@labdigital.nl>",
	"description": "Federated token plugin for GraphQL Yoga",
	"keywords": [
		"authentication",
		"graphql",
		"yoga"
	],
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js"
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"test:ci": "vitest run --coverage",
		"tsc": "tsc --noEmit"
	},
	"dependencies": {
		"@labdigital/federated-token": "workspace:*"
	},
	"devDependencies": {
		"@types/express": "5.0.6",
		"@typescript-eslint/eslint-plugin": "8.67.0",
		"@vitest/coverage-v8": "4.1.11",
		"graphql-yoga": "5.22.0",
		"node-mocks-http": "1.18.1",
		"publint": "^0.3.24",
		"tsdown": "^0.22.14",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"files": [
		"dist",
		"src"
	],
	"module": "./dist/index.js",
	"peerDependencies": {
		"graphql": ">= 16.6.0",
		"graphql-yoga": ">= 5.0.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/labd/node-federated-token.git"
	}
}
