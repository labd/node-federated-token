{
	"name": "@labdigital/federated-token-express-adapter",
	"version": "2.2.0",
	"author": "Lab Digital <opensource@labdigital.nl>",
	"description": "Express Adapter for @labdigital/federated-token",
	"keywords": [
		"authentication",
		"fastify",
		"graphql"
	],
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js"
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"test:ci": "vitest run --coverage",
		"tsc": "tsc --noEmit"
	},
	"dependencies": {
		"@labdigital/federated-token": "workspace:*",
		"cookie": "2.0.1"
	},
	"devDependencies": {
		"@types/express": "5.0.6",
		"@vitest/coverage-v8": "4.1.11",
		"node-mocks-http": "1.18.1",
		"publint": "^0.3.24",
		"tsdown": "^0.22.14",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"files": [
		"dist",
		"src"
	],
	"module": "./dist/index.js",
	"peerDependencies": {
		"express": ">= 4"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/labd/node-federated-token.git"
	}
}
