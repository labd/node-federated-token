{
	"name": "@labdigital/federated-token-fastify-adapter",
	"version": "3.0.0",
	"author": "Lab Digital <opensource@labdigital.nl>",
	"description": "Fastify Adapter for @labdigital/federated-token",
	"keywords": [
		"authentication",
		"fastify",
		"graphql"
	],
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js"
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"test:ci": "vitest run --coverage",
		"tsc": "tsc --noEmit"
	},
	"dependencies": {
		"@labdigital/federated-token": "workspace:*"
	},
	"devDependencies": {
		"@fastify/cookie": "11.1.2",
		"@vitest/coverage-v8": "4.1.11",
		"fastify": "5.12.1",
		"publint": "^0.3.24",
		"tsdown": "^0.22.14",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"files": [
		"dist",
		"src"
	],
	"module": "./dist/index.js",
	"peerDependencies": {
		"@fastify/cookie": ">= 11",
		"fastify": ">= 5"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/labd/node-federated-token.git"
	}
}
